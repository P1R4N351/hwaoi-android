# Never commit game files, dumps, keys, firmware, shaders, saves, or local build outputs
*.nup
*.nca
*.nsp
*.nsz
*.xci
*.xcz
*.rar
*.7z
*.keys
prod.keys
title.keys
dev.keys
*.sav
*.bfsha
*.bfsha.zs
*.bnsh
*.bntx*
*.patched.bin
*.spv
*.metallib
*.apk
*.aab
*.idsig
*.keystore
*.jks
*.p12
*.pem

# Directories holding local dumps, work trees, or builds
build/
dist/
out/
work/
extracted/
rewritten/
game-data/
exefs/
romfs/
saves/
shaders/
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
